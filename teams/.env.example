# Copy to teams/.env (gitignored) to override the defaults.
# Defaults already work: the opencode-go key in the repo root .env is used
# with https://opencode.ai/zen/go/v1 and deepseek-v4-flash.
# Any OpenAI-compatible /chat/completions endpoint can be substituted instead
# (OpenAI, Azure, Mistral, vLLM, Ollama, ...).
COPILOT_BASE_URL=https://opencode.ai/zen/go/v1
COPILOT_API_KEY=replace-me
COPILOT_MODEL=deepseek-v4-flash
# Only needed for opencode endpoints: keeps gateway routing/cache affinity.
# COPILOT_SESSION_ID=
